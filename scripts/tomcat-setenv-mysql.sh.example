#!/usr/bin/env bash
# Copy to ~/tomcat/bin/setenv.sh and fill in local values.
# Do NOT commit a real setenv.sh.

export SPRING_PROFILES_ACTIVE=mysql
export CX_DB_USER=cx
export CX_DB_PASSWORD='CHANGE_ME'

# Absolute upload root (avoid relative ./data breaking after Tomcat restart)
export FLOWDESK_DATA_DIR="${FLOWDESK_DATA_DIR:-$HOME/flowdesk-data}"

export CATALINA_OPTS="$CATALINA_OPTS -Dspring.profiles.active=${SPRING_PROFILES_ACTIVE} -DFLOWDESK_DATA_DIR=${FLOWDESK_DATA_DIR}"
