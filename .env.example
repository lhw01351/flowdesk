# FlowDesk 로컬/서버 시크릿 예시
# 사용: cp .env.example .env 후 값 채우기 (.env 는 gitignore)
# Tomcat: scripts/tomcat-setenv-mysql.sh → ~/tomcat/bin/setenv.sh 에 export

# --- MySQL (profile=mysql) ---
CX_DB_URL=jdbc:mysql://127.0.0.1:3306/cx_tracker?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Seoul&allowPublicKeyRetrieval=true&useSSL=false
CX_DB_USER=cx
CX_DB_PASSWORD=

# --- Oracle (profile=oracle, 선택) ---
# CX_ORACLE_URL=jdbc:oracle:thin:@//127.0.0.1:1521/XEPDB1
# CX_ORACLE_USER=cx
# CX_ORACLE_PASSWORD=

# --- 업로드 루트 ---
FLOWDESK_DATA_DIR=

# --- 시드 계정 비밀번호 (빈 값이면 해당 계정 신규 시드 생략) ---
# 이미 DB에 계정이 있으면 기존 비번 유지
FLOWDESK_PASS_ADMIN=
FLOWDESK_PASS_HWLEE=
FLOWDESK_PASS_HANI=
# 포폴 공개 데모 (미설정 시 앱 기본 guest)
FLOWDESK_PASS_GUEST=guest

# --- smoke-test.sh (선택) ---
# FD_PASS_ADMIN=
# FD_PASS_HWLEE=
# FD_PASS_HANI=
# FD_PASS_GUEST=guest
